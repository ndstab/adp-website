# Public site URL (used for metadata, sitemap and hreflang)
NEXT_PUBLIC_SITE_URL=https://adpway.com

# Show dashed VERIFY markers next to unverified claims. Set to "false" for launch.
NEXT_PUBLIC_REVIEW_MODE=true

# Form delivery: set EITHER Resend OR SMTP. With neither set, submissions are logged in development only.
CONTACT_TO_EMAIL=info@adpway.com
CONTACT_FROM_EMAIL=website@adpway.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Analytics loads only after a visitor accepts analytics cookies. Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=adpway.com
